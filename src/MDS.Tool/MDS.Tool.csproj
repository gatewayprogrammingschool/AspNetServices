<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MDS.Tool</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>mds</ToolCommandName>
    <IsPackable>true</IsPackable>
    <Description>MarkdownServer dotnet tool</Description>
    <PackageProjectUrl>https://github.com/sharpninja/AspNetServices</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sharpninja/AspNetServices</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageId>MarkdownServer.Tool</PackageId>
    <Authors>@sharpninja</Authors>
    <Product>MarkdownServer.Tool</Product>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MDS.AspnetServices\MDS.AspnetServices.csproj" />
  </ItemGroup>

</Project>